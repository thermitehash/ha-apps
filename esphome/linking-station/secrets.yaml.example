# Copy to secrets.yaml in your ESPHome config folder and fill in.
# Never commit secrets.yaml.
wifi_ssid: "your-iot-ssid"
wifi_password: "change-me"
# Keep the wall scanner's existing key so Home Assistant stays paired
# (or generate one: openssl rand -base64 32).
kroger_scanner_api_key: "PASTE-YOUR-GENERATED-KEY-HERE"
kroger_scanner_fallback_password: "change-me-too"
# Mosquitto broker (the Mosquitto app on Home Assistant). Create a Home
# Assistant user (e.g. "linking-station") for MQTT and use it here.
mqtt_broker: "192.168.1.38"
mqtt_username: "linking-station"
mqtt_password: "change-me"
