---
extends: default
ignore: |
  .esphome/
  **/.esphome/
  **/secrets.yaml
rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start: disable
  braces:
    max-spaces-inside: 1
